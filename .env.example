# =========================================================
# KEYCLOAK MODERN AUTHENTICATION — ENVIRONMENT VARIABLES
# =========================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env is git-ignored; this template is the committed contract.
# Every variable below is required unless marked optional — compose.yml
# substitutes an empty string for missing ones, which surfaces as a confusing
# runtime error rather than a clean failure. Run `docker compose config` to see
# exactly what was substituted.
#
# Reference for every value: docs/docker-configuration.md
#
# The defaults here are deliberately weak local-development values.
# Never reuse them on a host reachable from a network you do not control.

# =========================================================
# DATABASE (postgres:18)
# =========================================================
# USER / PASSWORD / DB are applied by the Postgres image ONLY on first start,
# while the data volume is empty. Changing them afterwards requires an
# ALTER ROLE inside the database, or `docker compose down -v` (destroys realms).
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=keycloak123
KEYCLOAK_POSTGRES_DB=keycloak

# HOST-side port only. Keycloak always reaches the database on the internal
# 5432 over the bridge network. Change this if a local Postgres owns 5432.
KEYCLOAK_POSTGRES_PORT=5432

# =========================================================
# KEYCLOAK — HOSTNAME
# =========================================================
# Public base URL Keycloak advertises in the OIDC discovery document, token
# issuers and redirects. It must match the URL your clients actually use.
KEYCLOAK_HOSTNAME=localhost

# false = infer the host from the incoming request (convenient locally).
# Set true in production so a spoofed Host header cannot rewrite token issuers.
KEYCLOAK_HOSTNAME_STRICT=false

# =========================================================
# KEYCLOAK — HTTP
# =========================================================
# Allow plain HTTP. Fine locally; in production only behind a TLS-terminating
# reverse proxy on a trusted network.
KEYCLOAK_HTTP_ENABLED=true

# HOST-side port only; the container always listens on 8080.
# Admin console: http://localhost:${KEYCLOAK_PORT}/admin
KEYCLOAK_PORT=8080

# =========================================================
# KEYCLOAK — REVERSE PROXY
# =========================================================
# Which forwarding headers to trust: `xforwarded` (X-Forwarded-For/-Proto/-Host)
# or `forwarded` (RFC 7239). Only meaningful when a reverse proxy sits in front
# AND strips client-supplied forwarding headers — otherwise they can be forged.
KEYCLOAK_PROXY_HEADERS=xforwarded

# =========================================================
# KEYCLOAK — OBSERVABILITY
# =========================================================
# Optional (defaults to info in compose.yml). Accepts per-category overrides,
# e.g. info,org.keycloak.events:debug to trace authentication events only.
KEYCLOAK_LOG_LEVEL=info

# Optional (defaults to false). Prometheus /metrics on the management port
# 9000, which is unauthenticated and not published by this stack.
KEYCLOAK_METRICS_ENABLED=false

# =========================================================
# KEYCLOAK — ADMIN BOOTSTRAP
# =========================================================
# Creates the temporary master-realm admin on FIRST start only. Editing these
# later has no effect — manage admins through the console or kcadm.sh.
# In production: log in once, create a real admin with MFA, delete this one.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin123
